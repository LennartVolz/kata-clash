// Datenmodell: Nutzer, Auth.js und Live-Duelle (Phase 4).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Nutzer mit Elo-Wert. `passwordHash` ist nur bei Credentials-Login gesetzt.
model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  elo           Int           @default(1200)
  wins          Int           @default(0)
  losses        Int           @default(0)
  draws         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  sessions      Session[]
  matches       MatchPlayer[]
  wonMatches    Match[]       @relation("MatchWinner")
}

/// Verknüpft OAuth-Konten (z. B. GitHub) mit einem Nutzer.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Datenbank-Sessions; aktuell nutzt die App JWT-Sessions, die Tabelle bleibt für OAuth.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Sprachen, in denen Duelle ausgetragen werden (siehe `LANGUAGES` in @kata-clash/shared).
enum Language {
  javascript
  python
}

/// Lebenszyklus eines Duells: angelegt, läuft, beendet oder abgebrochen.
enum MatchStatus {
  WAITING
  RUNNING
  FINISHED
  ABORTED
}

/// Ein Duell zweier Spieler über eine Kata. Katas liegen im Code (`packages/katas`), daher nur der Slug.
model Match {
  id        String        @id @default(cuid())
  kataSlug  String
  language  Language
  status    MatchStatus   @default(WAITING)
  startsAt  DateTime?
  /// Geplantes Ende (Start + Zeitlimit der Kata).
  endsAt    DateTime?
  endedAt   DateTime?
  winnerId  String?
  winner    User?         @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  players   MatchPlayer[]

  @@index([status, createdAt])
  @@index([winnerId])
}

/// Teilnahme eines Spielers: Elo vor/nach dem Duell, Ergebnis und abgegebener Code.
model MatchPlayer {
  id          String    @id @default(cuid())
  matchId     String
  userId      String
  eloBefore   Int
  eloAfter    Int?
  testsPassed Int       @default(0)
  finalCode   String?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}
