# Kopieren nach .env und Werte anpassen (.env wird nicht committet)

POSTGRES_USER=kata
POSTGRES_PASSWORD=kata_dev_password
POSTGRES_DB=kata_clash

DATABASE_URL=postgresql://kata:kata_dev_password@localhost:5432/kata_clash
REDIS_URL=redis://localhost:6379

SERVER_PORT=4000
# Adresse der API für apps/web (Server-seitig und für den /api/run-Proxy)
SERVER_URL=http://127.0.0.1:4000

# Sandbox-Runner (Phase 1) – alle Werte optional
RUNNER_DOCKER=docker
RUNNER_JS_IMAGE=kata-clash/js:latest
RUNNER_PYTHON_IMAGE=kata-clash/python:latest
RUNNER_TIMEOUT_MS=15000
RUNNER_MEMORY_MB=256
RUNNER_CPUS=1
RUNNER_PIDS_LIMIT=64
RUNNER_MAX_OUTPUT_BYTES=65536
RUNNER_TMPFS_MB=16
RUNNER_MAX_OPEN_FILES=64
